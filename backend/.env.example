# Core
DJANGO_ENV=dev
SECRET_KEY=django-insecure-change-me-for-production
# Must match volume keys in docker-compose.yml (aevora_*_volume / aevora_*_data)
PROJECT=aevora
DJANGO_SETTINGS_MODULE=config.settings.dev
MAIN_DOMAIN=localhost

# Onboarding / JWT (stateless tokens, nothing stored in DB)
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ONBOARDING_TOKEN_EXPIRY_HOURS=168
ACCESS_TOKEN_EXPIRY_MINUTES=30
APP_BASE_URL=http://localhost:3000

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgres://postgres:postgres@postgres:5434/postgres

# Individual DB vars (for Docker reference)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5434
POSTGRES_ENGINE=django.db.backends.postgresql

# Security
DEBUG=True
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.ngrok-free.app

# Email
# Local / no-op: django.core.mail.backends.console.EmailBackend
# Gmail SMTP:    django.core.mail.backends.smtp.EmailBackend
# AWS SES:       django_ses.SESBackend
# Dev: optional (defaults to console). Stage/prod: required.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=dev@hr-tool.ai
EMAIL_TIMEOUT=10

# SMTP (only needed when EMAIL_BACKEND=...smtp.EmailBackend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# SES (only needed when EMAIL_BACKEND=django_ses.SESBackend)
AWS_SES_REGION_NAME=eu-north-1
# AWS_SES_REGION_ENDPOINT=email.eu-north-1.amazonaws.com

# Celery
CELERY_BROKER_URL=redis://redis:6382/0
CELERY_RESULT_BACKEND=redis://redis:6382/0

# Flower
FLOWER_USERNAME=admin
FLOWER_PASSWORD=admin@1234

# AWS
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_STORAGE_BUCKET_NAME=hr-tool-media
AWS_S3_REGION_NAME=us-east-1

# REDIS
REDIS_HOST=redis
REDIS_PORT=6382
REDIS_URL=redis://redis:6382/0

# Frontend URLs
PLATFORM_SIGNUP_URL=http://localhost:3000/signup/

# Firebase
FIREBASE_SERVICE_ACCOUNT_FILE=hr-tool-firebase-adminsdk.json

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
