{
  "name": "aevora-frontend",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:all": "bash ../backend/start_aevora.sh && turbo run dev",
    "stack:up": "bash ../backend/start_aevora.sh",
    "electron": "npm --prefix ../electron start",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:orb": "node scripts/test-orb.mjs",
    "test:orb:fixture": "node scripts/build-orb-harness.mjs",
    "test:orb:browser": "python tests/orb/browser_smoke.py",
    "test:voice": "node --no-warnings --experimental-strip-types --test tests/voice/voice.test.mjs",
    "verify:ui": "node scripts/verify-ui-integrity.mjs",
    "test:optimization": "node scripts/verify-ui-integrity.mjs && node scripts/test-optimization.mjs",
    "test:ui:fixture": "node scripts/build-optimization-fixture.mjs",
    "test:ui": "node scripts/build-optimization-fixture.mjs && python tests/optimization/browser_smoke.py"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.10.2"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
